+    #[test]
+    fn rgb_only_skips_cooling_controllers_with_populated_config() {
+        let mut manager = ServiceManager::new(PathBuf::from("/nonexistent/config.json"), true, false).unwrap();
+        let mut config = AppConfig::default();
