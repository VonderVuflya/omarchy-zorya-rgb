+#[cfg(test)]
+mod resume_tests {
+    use super::*;
+    use std::fs::{File, FileTimes};
+    use std::time::SystemTime;
+
+    #[test]
+    fn stale_or_invalid_coolant_does_not_reuse_cached_temperature() {
+        let path = std::env::temp_dir().join(format!("lianli-fan-resume-test-{}", std::process::id()));
+        std::fs::write(&path, "34").unwrap();
+        let source = SensorSource::WirelessCoolant { device_id: "test".into() };
+        let mut cache = HashMap::from([(source.clone(), ResolvedSensor::RuntimeFile(path.clone()))]);
+        let mut ema = HashMap::new();
+        assert_eq!(smoothed_temperature(&source, &mut cache, &mut ema, &[]).unwrap(), 34.0);
+        File::options().write(true).open(&path).unwrap().set_times(
+            FileTimes::new().set_modified(SystemTime::now() - Duration::from_secs(20))
+        ).unwrap();
+        assert!(smoothed_temperature(&source, &mut cache, &mut ema, &[]).is_err());
+        std::fs::write(&path, "NaN").unwrap();
+        assert!(smoothed_temperature(&source, &mut cache, &mut ema, &[]).is_err());
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn shared_sensor_is_smoothed_once_for_all_fan_slots() {
+        let path = std::env::temp_dir().join(format!("lianli-fan-slots-test-{}", std::process::id()));
+        std::fs::write(&path, "35").unwrap();
+        let source = SensorSource::WirelessCoolant { device_id: "slots".into() };
+        let mut cache = HashMap::from([(source.clone(), ResolvedSensor::RuntimeFile(path.clone()))]);
+        let mut ema = HashMap::from([(source.clone(), 25.0)]);
+        let curves = HashMap::from([("test".into(), FanCurve {
+            name: "test".into(), temp_source: Some(source), temp_command: String::new(),
+            curve: vec![(0.0, 0.0), (100.0, 100.0)],
+        })]);
+        let slots = std::array::from_fn(|_| FanSpeed::Curve("test".into()));
+        let pwm = calculate_fan_speeds(&slots, &curves, &mut cache, &mut ema, &[], None, 1.0, 5).unwrap();
+        assert_eq!(pwm, [71; 4]);
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn coolant_curve_increases_speed_and_reaches_full_speed() {
+        let curve = [(25.0, 40.0), (30.0, 45.0), (35.0, 51.0), (38.0, 65.0), (42.0, 85.0), (45.0, 100.0)];
+        assert!((interpolate_curve(&curve, 34.0) - 49.8).abs() < 0.01);
+        assert_eq!(interpolate_curve(&curve, 40.0), 75.0);
+        assert_eq!(interpolate_curve(&curve, 50.0), 100.0);
+    }
