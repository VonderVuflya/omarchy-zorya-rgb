+#[cfg(test)]
+mod connection_tests {
+    use super::*;
+
+    #[test]
+    fn idle_connection_survives_timeout_and_fragmented_header() {
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let mut peer = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (stream, _) = listener.accept().unwrap();
+        stream.set_read_timeout(Some(Duration::from_millis(20))).unwrap();
+        let stop = Arc::new(AtomicBool::new(false));
+        let reader = thread::spawn(move || {
+            let mut handler = ClientHandler::new(
+                stream, Arc::new(Mutex::new(RgbController::new(HashMap::new(), None))),
+                Arc::new(Mutex::new(DirectColorBuffer::new())), stop,
+            );
+            handler.read_packet().unwrap()
+        });
+        thread::sleep(Duration::from_millis(80));
+        let mut header = Vec::from(&b"ORGB"[..]);
+        header.extend(0u32.to_le_bytes());
+        header.extend(PKT_REQUEST_PROTOCOL_VERSION.to_le_bytes());
+        header.extend(4u32.to_le_bytes());
+        peer.write_all(&header[..3]).unwrap();
+        thread::sleep(Duration::from_millis(40));
+        peer.write_all(&header[3..]).unwrap();
+        peer.write_all(&4u32.to_le_bytes()).unwrap();
+        let (device, packet, payload) = reader.join().unwrap();
+        assert_eq!(device, 0);
+        assert_eq!(packet, PKT_REQUEST_PROTOCOL_VERSION);
+        assert_eq!(payload, 4u32.to_le_bytes());
+    }
+}
