+/// Keep PWM and the cached lighting upload contiguous under the caller's TX lock.
+fn send_pwm_and_rgb(
+    pwm: &[u8],
+    rgb: Option<&[(Vec<u8>, u64)]>,
+    mut send: impl FnMut(&[u8]) -> Result<()>,
+) -> Result<()> {
+    send(pwm)?;
+    if let Some(packets) = rgb {
+        for (packet, gap_ms) in packets {
+            send(packet)?;
+            if *gap_ms > 0 { thread::sleep(Duration::from_millis(*gap_ms)); }
+        }
+    }
+    Ok(())
