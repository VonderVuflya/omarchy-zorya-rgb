+
+/// Validate the complete cached transaction before writing, then preserve order
+/// and original header gaps. Return its animation identity only after success.
+fn replay_rgb_packets(
+    packets: &[(Vec<u8>, u64)],
+    mut send: impl FnMut(&[u8]) -> Result<()>,
+) -> Result<[u8; 4]> {
+    anyhow::ensure!(!packets.is_empty(), "empty RGB replay cache");
+    anyhow::ensure!(packets.iter().all(|(packet, _)| {
+        packet.len() == RF_DATA_SIZE && packet[0] == RF_SELECT && packet[1] == RF_SET_RGB
+    }), "invalid RGB replay cache");
+    let header = &packets[0].0;
+    anyhow::ensure!(header[18] == 0, "RGB replay cache has no header");
+    let effect_index: [u8; 4] = header[14..18].try_into().unwrap();
+    for (packet, gap_ms) in packets {
+        send(packet)?;
+        if *gap_ms > 0 { thread::sleep(Duration::from_millis(*gap_ms)); }
+    }
+    Ok(effect_index)
+}
+
+#[cfg(test)]
+mod cached_replay_tests {
+    use super::*;
+
+    fn animation() -> Vec<(Vec<u8>, u64)> {
+        let mut header = vec![0; RF_DATA_SIZE];
+        header[0] = RF_SELECT;
+        header[1] = RF_SET_RGB;
+        header[14..18].copy_from_slice(&[1, 3, 5, 7]);
+        header[26] = 64;
+        let mut payload = header.clone();
+        payload[18] = 1;
+        payload[20..24].copy_from_slice(&[42, 43, 44, 45]);
+        vec![(header.clone(), 0), (header, 0), (payload, 0)]
+    }
+
+    #[test]
+    fn cached_replay_preserves_animation_frames_and_effect_identity() {
+        let packets = animation();
+        let mut sent = Vec::new();
+        let index = replay_rgb_packets(&packets, |packet| {
+            sent.push(packet.to_vec());
+            Ok(())
+        }).unwrap();
+        assert_eq!(index, [1, 3, 5, 7]);
+        assert_eq!(sent, packets.iter().map(|(data, _)| data.clone()).collect::<Vec<_>>());
+        assert_eq!(sent[0][26], 64);
+        assert_eq!(&sent[2][20..24], &[42, 43, 44, 45]);
+    }
+
+    #[test]
+    fn cached_replay_stops_on_transport_error() {
+        let mut calls = 0;
+        let result = replay_rgb_packets(&animation(), |_| {
+            calls += 1;
+            anyhow::bail!("transport offline")
+        });
+        assert!(result.is_err());
+        assert_eq!(calls, 1);
+    }
+
+    #[test]
+    fn malformed_cache_cannot_send_any_packet() {
+        let mut packets = animation();
+        packets[2].0.truncate(17);
+        assert!(replay_rgb_packets(&packets, |_| panic!("invalid cache was sent")).is_err());
+    }
+}
