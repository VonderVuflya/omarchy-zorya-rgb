 use tracing::debug;
 
 impl WirelessController {
+    /// Replay the complete last accepted RGB upload without changing fan/PWM state.
+    /// Keep cache -> TX -> desired-effect lock ordering identical to RGB uploads.
+    pub fn replay_cached_rgb(&self, mac: &[u8; 6]) -> Result<bool> {
+        let device = self.discovered_devices.lock().iter()
+            .find(|device| &device.mac == mac).cloned()
+            .context("device not found for RGB replay")?;
+        let cache = self.rgb_packets.lock();
+        let Some(packets) = cache.get(mac) else { return Ok(false); };
+        let effect_index = self.tx_recover(|handle| {
+            replay_rgb_packets(packets, |packet| self.send_rf_packet(handle, &device, packet))
+        })?;
+        self.desired_effects.lock().insert(*mac, effect_index);
+        Ok(true)
+    }
